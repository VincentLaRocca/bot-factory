{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "obs": "https://aiop.dev/profiles/observer#",

    "Observer": "prov:SoftwareAgent",
    "Capability": "obs:Capability",
    "Mission": "obs:Mission",
    "Sensor": "obs:Sensor",
    "Observation": "obs:Observation",
    "Anomaly": "obs:Anomaly",
    "ExecutionRecord": "prov:Activity",

    "name": "schema:name",
    "description": "schema:description",
    "version": "schema:version",
    "status": "obs:status",

    "chassis": "obs:chassis",
    "capabilities": {"@id": "obs:capabilities", "@container": "@set"},
    "compatible_with": {"@id": "obs:compatibleWith", "@container": "@set"},
    "permitted_resources": {"@id": "obs:permittedResources", "@container": "@set"},
    "objective": "obs:objective",
    "success_conditions": {"@id": "obs:successConditions", "@container": "@set"},
    "termination_conditions": {"@id": "obs:terminationConditions", "@container": "@set"},
    "escalation_conditions": {"@id": "obs:escalationConditions", "@container": "@set"},
    "priority": "obs:priority",
    "required_capabilities": {"@id": "obs:requiredCapabilities", "@container": "@set"},
    "authority": {"@id": "obs:authority", "@container": "@set"},
    "granted": {"@id": "obs:granted", "@container": "@set"},
    "output_expectations": {"@id": "obs:outputExpectations", "@container": "@set"},

    "capability": "obs:capability",
    "capability_version": "obs:capabilityVersion",
    "accepts": {"@id": "obs:accepts", "@container": "@set"},
    "produces": {"@id": "obs:produces", "@container": "@set"},
    "requires": {"@id": "obs:requires", "@container": "@set"},
    "dependencies": {"@id": "obs:dependencies", "@container": "@set"},

    "target": {"@id": "obs:target", "@type": "@id"},
    "target_property": "obs:targetProperty",
    "input_fingerprint": "obs:inputFingerprint",
    "findings": {"@id": "obs:findings", "@type": "@json"},
    "value": "obs:value",
    "unit": "obs:unit",
    "modality": "obs:modality",
    "method": "prov:wasGeneratedBy",
    "confidence": {"@id": "obs:confidence", "@type": "xsd:decimal"},
    "observed_at": {"@id": "prov:generatedAtTime", "@type": "xsd:dateTime"},
    "independence_group": "obs:independenceGroup",
    "sensor": {"@id": "obs:sensor", "@type": "@id"},
    "sequence": {"@id": "obs:sequence", "@type": "xsd:integer"},

    "score": {"@id": "obs:score", "@type": "xsd:decimal"},
    "signals": {"@id": "obs:signals", "@type": "@json"},
    "dimensions": {"@id": "obs:dimensions", "@container": "@set"},
    "expected_state": "obs:expectedState",
    "observed_state": "obs:observedState",
    "magnitude": {"@id": "obs:magnitude", "@type": "xsd:decimal"},
    "comparison_context": {"@id": "obs:comparisonContext", "@container": "@set"},
    "historical_comparison": {"@id": "obs:historicalComparison", "@type": "@json"},
    "reasons": {"@id": "obs:reasons", "@container": "@set"},
    "disposition": "obs:disposition",
    "detected_by": {"@id": "obs:detectedBy", "@type": "@id"},
    "detected_at": {"@id": "obs:detectedAt", "@type": "xsd:dateTime"},
    "detector_version": "obs:detectorVersion",

    "observer": {"@id": "obs:observer", "@type": "@id"},
    "observer_version": "obs:observerVersion",
    "mission": {"@id": "obs:mission", "@type": "@id"},
    "invoked": "obs:invoked",
    "policy": {"@id": "obs:policy", "@type": "@json"},
    "refusal": "obs:refusal",
    "missing_capabilities": {"@id": "obs:missingCapabilities", "@container": "@set"},
    "missing_authority": {"@id": "obs:missingAuthority", "@container": "@set"},
    "started_at": {"@id": "prov:startedAtTime", "@type": "xsd:dateTime"},
    "completed_at": {"@id": "prov:endedAtTime", "@type": "xsd:dateTime"},
    "inputs_read": {"@id": "obs:inputsRead", "@container": "@set"},
    "objects_created": {"@id": "obs:objectsCreated", "@container": "@set"},

    "about": {"@id": "obs:about", "@type": "@id"},
    "subjectOf": {"@id": "obs:subjectOf", "@type": "@id"},
    "observedBy": {"@id": "prov:wasAttributedTo", "@type": "@id"},
    "observed": {"@id": "obs:observed", "@type": "@id"},
    "sensedBy": {"@id": "obs:sensedBy", "@type": "@id"},
    "sensed": {"@id": "obs:sensed", "@type": "@id"},
    "detectedBy": {"@id": "obs:detectedBy", "@type": "@id"},
    "detected": {"@id": "obs:detected", "@type": "@id"},
    "comparedWith": {"@id": "obs:comparedWith", "@type": "@id"},
    "comparedBy": {"@id": "obs:comparedBy", "@type": "@id"},
    "assigned": {"@id": "obs:assigned", "@type": "@id"},
    "assignedTo": {"@id": "obs:assignedTo", "@type": "@id"},
    "installed": {"@id": "obs:installed", "@type": "@id"},
    "installedOn": {"@id": "obs:installedOn", "@type": "@id"},
    "produced": {"@id": "prov:generated", "@type": "@id"},
    "producedBy": {"@id": "prov:wasGeneratedBy", "@type": "@id"}
  }
}
