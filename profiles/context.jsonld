{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "demo": "https://aiop.dev/profiles/demo#",

    "Agent": "prov:Agent",
    "Person": "schema:Person",
    "Animal": "schema:Animal",
    "Dog": "demo:Dog",
    "Story": "schema:CreativeWork",
    "Character": "demo:Character",
    "Company": "schema:Organization",
    "Policy": "demo:Policy",
    "Opportunity": "demo:Opportunity",
    "Calculation": "demo:Calculation",
    "Technology": "demo:Technology",
    "Evidence": "demo:Evidence",
    "Market": "demo:Market",
    "Result": "demo:Result",

    "name": "schema:name",
    "title": "schema:name",
    "description": "schema:description",
    "age": {"@id": "schema:age", "@type": "xsd:integer"},
    "breed": "demo:breed",
    "email": "schema:email",
    "industry": "schema:industry",
    "value": {"@id": "demo:value", "@type": "xsd:decimal"},
    "currency": "demo:currency",
    "stage": "demo:stage",
    "rate": {"@id": "demo:rate", "@type": "xsd:decimal"},
    "expression": "demo:expression",
    "function": "demo:function",
    "inputs": {"@id": "demo:input", "@container": "@set"},
    "variable": "demo:variable",
    "result": "demo:result",
    "inputFingerprint": "demo:inputFingerprint",
    "calculation": {"@id": "demo:calculation", "@type": "@id"},
    "upside": {"@id": "demo:upside", "@type": "xsd:decimal"},
    "downside": {"@id": "demo:downside", "@type": "xsd:decimal"},
    "execution_probability": {"@id": "demo:executionProbability", "@type": "xsd:decimal"},
    "success_probability": {"@id": "demo:successProbability", "@type": "xsd:decimal"},
    "adoption_probability": {"@id": "demo:adoptionProbability", "@type": "xsd:decimal"},
    "units": "demo:units",
    "role": "demo:role",
    "since": {"@id": "demo:since", "@type": "xsd:date"},
    "fidelity": "demo:fidelity",

    "owns": {"@id": "demo:owns", "@type": "@id"},
    "ownedBy": {"@id": "demo:ownedBy", "@type": "@id"},
    "parentOf": {"@id": "demo:parentOf", "@type": "@id"},
    "childOf": {"@id": "demo:childOf", "@type": "@id"},
    "employs": {"@id": "demo:employs", "@type": "@id"},
    "worksFor": {"@id": "schema:worksFor", "@type": "@id"},
    "contains": {"@id": "demo:contains", "@type": "@id"},
    "partOf": {"@id": "demo:partOf", "@type": "@id"},
    "derivedFrom": {"@id": "prov:wasDerivedFrom", "@type": "@id"},
    "sourceOf": {"@id": "demo:sourceOf", "@type": "@id"},
    "authorOf": {"@id": "demo:authorOf", "@type": "@id"},
    "authoredBy": {"@id": "schema:author", "@type": "@id"},
    "portrays": {"@id": "demo:portrays", "@type": "@id"},
    "portrayedBy": {"@id": "demo:portrayedBy", "@type": "@id"},
    "relatedTo": {"@id": "demo:relatedTo", "@type": "@id"},
    "develops": {"@id": "demo:develops", "@type": "@id"},
    "developedBy": {"@id": "demo:developedBy", "@type": "@id"},
    "enables": {"@id": "demo:enables", "@type": "@id"},
    "enabledBy": {"@id": "demo:enabledBy", "@type": "@id"},
    "supports": {"@id": "demo:supports", "@type": "@id"},
    "supportedBy": {"@id": "demo:supportedBy", "@type": "@id"},
    "supersedes": {"@id": "demo:supersedes", "@type": "@id"},
    "supersededBy": {"@id": "demo:supersededBy", "@type": "@id"}
  }
}
