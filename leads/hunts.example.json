        },
        {
          "hunt": "jewelry",
          "q": "sterling silver jewelry lot grams",
          "max_price": 300
        },
        {
          "hunt": "jewelry",
          "q": "sterling silver bracelet heavy",
          "max_price": 250
        },
        {
          "hunt": "jewelry",
          "q": "navajo sterling turquoise",
          "max_price": 300
        },
        {
          "hunt": "jewelry",
          "q": "estate jewelry lot gold silver",
          "max_price": 400,
          "buying": "AUCTION"
        },
        {
          "hunt": "jewelry",
          "q": "(unmarked, untested) gold ring",
          "max_price": 400
        },
        {
          "hunt": "jewelry",
