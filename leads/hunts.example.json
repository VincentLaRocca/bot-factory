{
  "_readme": "Mispriced jewelry (gold, silver), bullion, gems: eBay (Browse API), estate-sale alerts, GSA surplus. Run: python -m leads --config leads/hunts.example.json sweep --dry-run. Never bids or buys.",
  "store": "var/hunts.db",
  "ledger": "var/hunts.jsonl",
  "sinks": {
    "slack": {
      "url": "${HUNT_SLACK_WEBHOOK_URL}",
      "min_urgency": "HIGH"
    }
  },
  "rules": {
    "exclude_any": [],
    "urgent_any": [],
    "min_score": 45
  },
  "listeners": [
    {
      "name": "ebay-jewelry",
      "kind": "ebay",
      "enabled": true,
      "_note": "Mispriced jewelry, gold AND silver: under melt, fine metal filed under fashion/costume, seller-unsure wording, designer/period names (verify), misspellings, dead auctions.",
      "client_id": "${EBAY_CLIENT_ID}",
      "client_secret": "${EBAY_CLIENT_SECRET}",
      "spot": {
        "silver": "${SILVER_SPOT_USD:-}",
        "gold": "${GOLD_SPOT_USD:-}"
      },
      "max_price_per_carat": {
        "sapphire": 100,
        "ruby": 100,
        "emerald": 80,
        "diamond": 300
      },
      "min_interval_minutes": 20,
      "queries": [
        {
          "hunt": "jewelry",
          "q": "14k gold ring grams",
          "max_price": 800
        },
        {
          "hunt": "jewelry",
          "q": "10k gold class ring",
          "max_price": 600
        },
        {
          "hunt": "jewelry",
          "q": "18k gold jewelry",
          "max_price": 1500
