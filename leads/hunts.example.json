      "rules": {
        "exclude_any": [
          "lab created",
          "lab-created",
          "lab grown",
          "simulated",
          "cz",
          "cubic zirconia",
          "moissanite",
          "gold plated",
          "gold filled",
          "gold tone",
          "silver plated",
          "silver tone",
          "replica",
          "inspired",
          "style",
          "dupe"
        ],
        "min_score": 45
      },
      "recovery": {
        "_note": "Vinny's value test: gram weight melted at spot + gem value vs price + shipping. stone_per_ct = YOUR base $/ct for a clean, natural, untreated ~1 ct stone; size, clarity, color, treatment, natural-vs-lab and certificate adjust it (leads/valuation.py GEM_FACTORS, overridable in gem_factors). 0 = stones not counted.",
        "stone_per_ct": {
          "diamond": 0,
          "sapphire": 0,
          "ruby": 0,
          "emerald": 0
        }
      }
    },
