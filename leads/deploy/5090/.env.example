# Copy to .env (same folder) and fill in. Never commit .env.
LEADS_WEBHOOK_TOKEN=make-a-long-random-string
LEAD_BOARD_API_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
SLACK_WEBHOOK_URL=
SAM_API_KEY=
LEADS_IMAP_USER=
LEADS_IMAP_PASSWORD=
GOOGLE_ALERT_PAINTING_RSS=
# Reddit (read-only, public JSON). Your username, and the subreddits you own (comma-separated)
REDDIT_USERNAME=
OWNED_SUBREDDITS=
# Optional second destination (Mid-Atlantic Lead Board)
MIDATLANTIC_WEBHOOK_URL=
MIDATLANTIC_WEBHOOK_TOKEN=
# Kit settings
LEADS_PORT=8080
SWEEP_EVERY=1800
# eBay hunt (developer.ebay.com → Application Keys → Production). Spot prices in USD per troy oz.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
SILVER_SPOT_USD=
GOLD_SPOT_USD=
HUNT_SLACK_WEBHOOK_URL=
# Only if you subscribe to eBay account-deletion notifications instead of the exemption:
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=
# GSA surplus auctions (api.data.gov key; DEMO_KEY works for a trial)
DATA_GOV_API_KEY=
# Value hunter (appraisers): your numbers
SCRAP_PER_TON=
CAT_CONVERTER_VALUE=
VALUE_COMPS_CSV=
